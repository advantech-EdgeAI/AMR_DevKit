<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="SHF3L_plate" params="parent_link">
    <link name="${parent_link}_SHF3L">
      <visual>
        <geometry>
          <mesh filename="package://devkit_description/meshes/visual/SHF3L_plate.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${parent_link}_SHF3L_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${parent_link}_SHF3L"/>
    </joint>
  </xacro:macro>

</robot>
