<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931"/>
  <xacro:macro name="rplidar" params="parent_link">
    <link name="${parent_link}_rplidar">
      <visual>
        <geometry>
          <mesh filename="package://devkit_description/meshes/visual/rplidar.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${parent_link}_rplidar_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${parent_link}_rplidar"/>
      <origin xyz="0 0 0" rpy="0 0 ${-M_PI/2}"/>
    </joint>
  </xacro:macro>

</robot>
